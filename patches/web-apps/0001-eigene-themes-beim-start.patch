---
 apps/common/main/lib/controller/Themes.js | 34 ++++++++++++++++++++++-
 apps/common/main/lib/util/desktopinit.js  |  8 ++++--
 apps/common/main/lib/util/themeinit.js    | 13 +++++++++
 3 files changed, 52 insertions(+), 3 deletions(-)

diff --git a/apps/common/main/lib/controller/Themes.js b/apps/common/main/lib/controller/Themes.js
index 1341a07438..fbab1c24b5 100644
--- a/apps/common/main/lib/controller/Themes.js
+++ b/apps/common/main/lib/controller/Themes.js
@@ -252,6 +252,24 @@ define([
             }
         };
 
+        // OpenIntra Edition: write the colors of a custom theme (local or from themes.json) once.
+        // apply_theme() did this on a switch only; at start-up a custom theme got its classes but
+        // no colors, the editor fell back to the old base style and stored those colors as the theme.
+        let custom_colors_written = false;  // since the last store in check_launched_custom_theme
+        const write_custom_colors = function (theme_id) {
+            const t = themes_map[theme_id];
+            if ( t && !!t.src && !!t.src.colors ) {
+                // ":root body.<id>" (0,2,1): for dark themes the built-in ":root .theme-type-dark"
+                // (0,2,0, the old Euro-Office dark) won against ":root .<id>" (as in OpenIntraHub).
+                write_theme_css(t.src.id, create_colors_css(t.src.id, t.src.colors).replace(':root .', ':root body.'));
+                normalize_theme_icons(t);
+                delete t.src;
+                custom_colors_written = true;
+            }
+            if ( t && !document.body.classList.contains(theme_id) )
+                document.body.classList.add(theme_id);
+        };
+
         var parse_themes_object = function (obj) {
             var curr_lang = Common.Locale.getCurrentLanguage(),
                 theme_label;
@@ -293,8 +311,12 @@ define([
                 document.body.classList.add(theme_id, 'theme-type-' + themes_map[theme_id].type);
             }
 
+            // OpenIntra Edition: colors of a custom theme (see write_custom_colors); the stored
+            // colors are refreshed too, they may stem from a start without them.
+            write_custom_colors(theme_id);
+
             const s = Common.localStorage.getItem('ui-theme');
-            if (!s || get_ui_theme_name(s) !== theme_id) {
+            if (!s || get_ui_theme_name(s) !== theme_id || custom_colors_written) {
                 var theme_obj = {
                     id: theme_id,
                     type: themes_map[theme_id].type,
@@ -306,6 +328,7 @@ define([
                     theme_obj.icons = themes_map[theme_id].icons;
 
                 Common.localStorage.setItem('ui-theme', JSON.stringify(theme_obj));
+                custom_colors_written = false;
             }
         }
 
@@ -475,6 +498,15 @@ define([
 
                 this.api = api;
 
+                // OpenIntra Edition: the desktop app knows its local themes from the start
+                // (RendererProcessVariable.localthemes). Read them now, not only on document:ready:
+                // with "like system" resolving to a local theme, isDarkTheme() met an empty entry
+                // during loading and the document failed to open.
+                if ( Common.Controllers.Desktop.isActive() && Common.Controllers.Desktop.localThemes() ) {
+                    parse_themes_object({'themes': Common.Controllers.Desktop.localThemes()});
+                    write_custom_colors(window.uitheme.relevant_theme_id());
+                }
+
                 const theme_id = window.uitheme.relevant_theme_id();
                 if ( window.uitheme.type && themes_map[theme_id] &&
                         window.uitheme.type !== themes_map[theme_id].type )
diff --git a/apps/common/main/lib/util/desktopinit.js b/apps/common/main/lib/util/desktopinit.js
index d540910b18..801e8c0ccc 100644
--- a/apps/common/main/lib/util/desktopinit.js
+++ b/apps/common/main/lib/util/desktopinit.js
@@ -54,8 +54,12 @@ if ( window.AscDesktopEditor ) {
                 }
             }
 
-            if ( map_themes && map_themes[theme.id] ) {
-                window.uitheme.colors = map_themes[theme.id].colors;
+            // OpenIntra Edition: the desktop app sends localthemes as a list
+            // (CThemes::localThemesToJson), not as an object keyed by id.
+            const local_theme = map_themes && (Array.isArray(map_themes) ?
+                    map_themes.find(function (t) { return !!t && t.id == theme.id; }) : map_themes[theme.id]);
+            if ( local_theme ) {
+                window.uitheme.colors = local_theme.colors;
                 // window.desktop.themes = map_themes;
             }
         }
diff --git a/apps/common/main/lib/util/themeinit.js b/apps/common/main/lib/util/themeinit.js
index 1eb58b9941..1dfc06bf1e 100644
--- a/apps/common/main/lib/util/themeinit.js
+++ b/apps/common/main/lib/util/themeinit.js
@@ -42,6 +42,19 @@
     window.uitheme.DEFAULT_LIGHT_THEME_ID = !window.isIEBrowser ? 'theme-white' : 'theme-classic-light';
     window.uitheme.DEFAULT_DARK_THEME_ID = !window.isIEBrowser ? 'theme-night' : 'theme-dark';
 
+    // OpenIntra Edition: "like system" follows OpenIntra light/dark when the desktop app ships
+    // them as local themes (uithemes/), as the app itself does (cthemes.cpp, systemThemeId).
+    +function () {
+        const local = window.RendererProcessVariable && window.RendererProcessVariable.localthemes;
+        const has = function (id) {
+            return !!local && (Array.isArray(local) ? local.some(function (t) { return !!t && t.id == id; }) : !!local[id]);
+        };
+        if ( has('theme-openintra-hell') && has('theme-openintra-dunkel') ) {
+            window.uitheme.DEFAULT_LIGHT_THEME_ID = 'theme-openintra-hell';
+            window.uitheme.DEFAULT_DARK_THEME_ID = 'theme-openintra-dunkel';
+        }
+    }();
+
     window.uitheme.set_id = function (id) {
         if ( id == 'theme-system' )
             this.adapt_to_system_theme();
