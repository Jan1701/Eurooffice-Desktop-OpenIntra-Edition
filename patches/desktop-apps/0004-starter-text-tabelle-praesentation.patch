diff --git a/package/Makefile b/package/Makefile
index 856d7c6ad..bf9f3c808 100644
--- a/package/Makefile
+++ b/package/Makefile
@@ -62,6 +62,10 @@ DESKTOPEDITORS_EXEC := $(PACKAGE_NAME)
 
 BIN_FILES += build/main/usr/bin/$(DESKTOPEDITORS_EXEC)
 DESKTOP_FILES += build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC).desktop
+# OpenIntra Edition: je ein Starter für Text, Tabelle und Präsentation, mit OpenIntra-Symbol
+OI_STARTER := text tabelle praesentation
+DESKTOP_FILES += $(foreach s,$(OI_STARTER),build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC)-$(s).desktop)
+LINUX_DEPS += $(foreach s,$(OI_STARTER),build/main/usr/share/icons/hicolor/scalable/apps/$(DESKTOPEDITORS_EXEC)-$(s).svg)
 LINUX_DEPS += $(BIN_FILES)
 LINUX_DEPS += $(DESKTOP_FILES)
 LINUX_DEPS += $(CHANGELOG_RPM)
@@ -350,6 +354,12 @@ $(TAR_HELP) : build
 
 build/main/usr/bin/$(DESKTOPEDITORS_EXEC) : common/linux/desktopeditors.sh.m4
 build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC).desktop : common/linux/desktopeditors.desktop.m4
+build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC)-text.desktop : common/linux/openintra/starter-text.desktop.m4
+build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC)-tabelle.desktop : common/linux/openintra/starter-tabelle.desktop.m4
+build/main/usr/share/applications/$(DESKTOPEDITORS_EXEC)-praesentation.desktop : common/linux/openintra/starter-praesentation.desktop.m4
+
+build/main/usr/share/icons/hicolor/scalable/apps/$(DESKTOPEDITORS_EXEC)-%.svg : common/linux/openintra/openintra-%.svg
+	install -m 644 -D $< $@
 
 $(BIN_FILES) $(DESKTOP_FILES) :
 	mkdir -p $(@D) && m4 -I "$(BRANDING_DIR)/common/linux" $(M4_PARAMS) $< > $@
