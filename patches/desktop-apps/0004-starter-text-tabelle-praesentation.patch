diff --git a/package/common/linux/desktopeditors.sh.m4 b/package/common/linux/desktopeditors.sh.m4
index 8913537f1..e4f3ec537 100644
--- a/package/common/linux/desktopeditors.sh.m4
+++ b/package/common/linux/desktopeditors.sh.m4
@@ -323,6 +323,23 @@ for arg in "$@"; do
   fi
 done
 
+# OpenIntra Edition: Starter Text/Tabelle/Präsentation rufen mit --starter:word|cell|slide.
+# Ohne Datei öffnet das ein neues Dokument dieser Art, mit Datei nur die Datei.
+STARTER_NEU=
+STARTER_DATEI=
+for arg do
+  shift
+  case $arg in
+    --starter:word|--starter:cell|--starter:slide) STARTER_NEU="--new:${arg#--starter:}"; continue ;;
+    --*) ;;
+    *) STARTER_DATEI=1 ;;
+  esac
+  set -- "$@" "$arg"
+done
+if [ -n "$STARTER_NEU" ] && [ -z "$STARTER_DATEI" ]; then
+  set -- "$@" "$STARTER_NEU"
+fi
+
 APP_PATH=/opt/M4_DESKTOPEDITORS_PREFIX
 export LD_LIBRARY_PATH=$APP_PATH:$APP_PATH/converter${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
 export LD_PRELOAD=$APP_PATH/libcef.so
