+    auto rememberStartEnvironment() -> void {
+        for (const char * k : g_own_env) {
+            if ( qEnvironmentVariableIsSet(k) )
+                g_start_env.insert(QString::fromLatin1(k), qEnvironmentVariable(k));
+        }
+        g_env_remembered = true;
+    }
+
+    auto openPdfExternally(const std::wstring& path, int format) -> bool {
+        const QFileInfo info(QString::fromStdWString(path));
+        // OpenIntraPDF nimmt nur *.pdf an; alles andere bleibt hier
+        if ( info.suffix().compare("pdf", Qt::CaseInsensitive) != 0 || !info.isFile() )
+            return false;
+        if ( format == 0 )
+            format = CCefViewEditor::GetFileFormat(path);
+        // XPS, DjVu usw. bleiben im eigenen Betrachter
+        if ( !isPdfFormat(format) )
+            return false;
+        const QString exe = pdfProgram();
+        if ( exe.isEmpty() )
+            return false; // kein PDF-Programm installiert: eigener Betrachter als Rückfall
+
+        QProcess proc;
+        proc.setProgram(exe);
+        proc.setArguments({info.absoluteFilePath()});
+        proc.setProcessEnvironment(cleanEnvironment());
+        proc.setWorkingDirectory(QDir::homePath());
+        return proc.startDetached();
+    }
+
+    auto handOverPdfsOnly(const std::vector<std::wstring>& args) -> bool {
+        std::vector<std::wstring> files;
+        for (const auto& a : args) {
+            QString arg = QString::fromStdWString(a);
+            if ( arg.startsWith("--") ) {
+                // Optionen wie --lang:de sind erlaubt, alles was etwas öffnet nicht
+                if ( arg.startsWith("--new") || arg.startsWith("--view") ||
+                        arg.startsWith("--edit") || arg.startsWith("--review") )
+                    return false;
+                continue;
+            }
+            if ( arg.startsWith("file://") )
+                arg = QUrl(arg).toLocalFile();
+            const QFileInfo info(arg);
+            if ( info.suffix().compare("pdf", Qt::CaseInsensitive) != 0 || !info.isFile() ||
+                    !isPdfFormat(CCefViewEditor::GetFileFormat(arg.toStdWString())) )
+                return false;
+            files.push_back(arg.toStdWString());
+        }
+        if ( files.empty() || pdfProgram().isEmpty() )
+            return false;
+        for (const auto& f : files)
+            openPdfExternally(f);
+        return true;
+    }
+
     auto editorTypeFromFormat(int format) -> AscEditorType {
         if ( format == AVS_OFFICESTUDIO_FILE_DOCUMENT_DOCXF ) {
             return AscEditorType::etDocumentMasterForm;
