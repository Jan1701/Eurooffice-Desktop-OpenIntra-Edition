 using namespace NSEditorApi;
 
+namespace {
+    // OpenIntra Edition: Variablen, die DesktopEditors selbst setzt (main.cpp,
+    // cthemes.cpp). Das PDF-Programm soll sie nicht erben.
+    const char * const g_own_env[] = {"QT_QPA_PLATFORM", "GDK_BACKEND", "QT_ENABLE_HIGHDPI_SCALING", "GTK_THEME"};
+    bool g_env_remembered = false;
+    QHash<QString, QString> g_start_env;
+
+    auto isPdfFormat(int format) -> bool {
+        return format == AVS_OFFICESTUDIO_FILE_CROSSPLATFORM_PDF ||
+               format == AVS_OFFICESTUDIO_FILE_CROSSPLATFORM_PDFA ||
+               format == AVS_OFFICESTUDIO_FILE_DOCUMENT_OFORM_PDF;
+    }
+
+    // Programm aus /etc/xdg/<REG_GROUP_KEY>/pdf-programm.conf, Schlüssel "programm";
+    // ohne Eintrag "openintrapdf", "intern" schaltet ab. Leer = nicht verfügbar.
+    auto pdfProgram() -> QString {
+        QSettings conf(QSettings::IniFormat, QSettings::SystemScope, REG_GROUP_KEY, "pdf-programm");
+        const QString name = conf.value("programm", "openintrapdf").toString().trimmed();
+        if ( name.isEmpty() || name == "intern" )
+            return QString();
+        return QStandardPaths::findExecutable(name);
+    }
+
+    // Der Starter setzt LD_PRELOAD=libcef.so und LD_LIBRARY_PATH auf die
+    // mitgelieferten Qt-/ICU-Bibliotheken; das darf das PDF-Programm nicht erben.
+    auto cleanEnvironment() -> QProcessEnvironment {
+        QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+        env.remove("LD_PRELOAD");
+        env.remove("LD_LIBRARY_PATH");
+        if ( g_env_remembered ) {
+            for (const char * k : g_own_env) {
+                const QString key = QString::fromLatin1(k);
+                if ( g_start_env.contains(key) )
+                    env.insert(key, g_start_env.value(key));
+                else env.remove(key);
+            }
+        }
+        return env;
+    }
+}
